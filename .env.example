# Application Environment (development | production)
APP_ENV=production

# Neon PostgreSQL connection string with SSL required
# Format: postgresql://<user>:<password>@<ep-pooler-id>.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Allowed CORS Origins (comma-separated; automatically permits https://*.vercel.app)
CORS_ORIGINS=http://localhost:5173,https://*.vercel.app

# YOLO Detection Model Configuration
MODEL_PATH=models/best.pt
MODEL_NAME=construction-waste-yolo
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_IOU_THRESHOLD=0.45
MAX_UPLOAD_MB=10

# Optional Gemini Vision Enrichment
GEMINI_ENABLED=false
GEMINI_API_KEY=
